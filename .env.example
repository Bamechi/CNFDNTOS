# Optional connected AI. Never put API keys in browser code or commit .env.
ANTHROPIC_API_KEY=
# Set a model available to your Claude API account.
ANTHROPIC_MODEL=

# Optional Google Calendar OAuth Web application, calendar.readonly only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4310/api/google/callback

# On a hosted HTTPS origin, set SECURE_COOKIE=1 and match GOOGLE_REDIRECT_URI.
SECURE_COOKIE=0
# HOST defaults to 127.0.0.1. Configure deliberately when deploying.
# HOST=127.0.0.1
# PORT=4310
# PDF, DOCX and TXT extraction uses the installed Node dependencies.

# Hosted deployment: connect a dedicated Neon Postgres database in Vercel.
# Local development continues to use SQLite when this is unset.
# DATABASE_URL=postgresql://...

# Stripe fulfillment for CNFDNT products.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# DELIVERY_TOKEN_SECRET=use-a-long-random-value
# PUBLIC_BASE_URL=https://cnfdnt.co
# Optional fallback opened when a product-specific assetUrl is not configured.
# DELIVERY_FALLBACK_URL=https://drive.google.com/drive/folders/1uHjxD_U1ZvbK3_AF_NE0BMGyLzkZkROY

# Optional automatic delivery emails through Resend.
# RESEND_API_KEY=re_...
# DELIVERY_EMAIL_FROM=CNFDNT <delivery@cnfdnt.co>
