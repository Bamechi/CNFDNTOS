{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "functions": {
    "server.mjs": {
      "maxDuration": 60,
      "includeFiles": "{public,seeds}/**"
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": "/os.html"
    },
    {
      "source": "/app/",
      "destination": "/os.html"
    }
  ]
}